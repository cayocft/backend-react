# Puerto donde escuchará el servidor
PORT=3000

# Prefijo base de todas las rutas de la API
API_PREFIX=/api-backend

# Secreto para firmar los tokens JWT (cámbialo por uno largo y aleatorio)
JWT_SECRET=cambia-este-secreto-por-uno-seguro

# Tiempo de expiración del token (ej: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Cadena de conexión de MongoDB Atlas.
# OJO: la contraseña entregada fue rechazada por Atlas (bad auth).
# Verifica usuario/password en Atlas → Database Access y corrígela aquí.
# Si la contraseña tiene caracteres especiales, escríbela URL-encoded
# (ej: "/" se escribe %2F).
MONGODB_URI=mongodb+srv://dbdoscamposUser:DMzZJTjlVsikQVMU@dbegresoscft.nacag.mongodb.net/backend-cft
