# Puerto donde escuchará el servidor
PORT=3000

# Prefijo base de todas las rutas de la API
API_PREFIX=/api-backend

# Secreto para firmar los tokens JWT (cámbialo por uno largo y aleatorio)
JWT_SECRET=cambia-este-secreto-por-uno-seguro

# Tiempo de expiración del token (ej: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Cadena de conexión de MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<nombre-db>
# Recuerda URL-encodear la contraseña si tiene caracteres especiales.
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/backend-cft
